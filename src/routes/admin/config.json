							"name": "eyebrowIcon",
							"label": "Eyebrow icon",
							"widget": "string",
							"required": false,
							"hint": "Icon file name without .svg (e.g. bolt). See /style-guide for examples."
						},
						{
							"name": "title",
							"label": "Title",
							"widget": "string"
						},
						{
							"name": "description",
							"label": "Description",
							"widget": "text",
							"required": false
						},
						{
							"name": "cta",
							"label": "Call to action",
							"widget": "object",
							"fields": [
								{
									"name": "primary",
									"label": "Primary button",
									"widget": "object",
									"required": true,
									"fields": [
										{
											"name": "text",
											"label": "Text",
											"widget": "string",
											"required": true
										},
										{
											"name": "textDescription",
											"label": "Accessible description",
											"widget": "string",
											"required": false,
											"hint": "Optional aria-label for screen readers"
										},
										{
											"name": "url",
											"label": "URL",
											"widget": "string",
											"required": true
										},
										{
											"name": "newTab",
											"label": "Open in new tab",
											"widget": "boolean",
											"default": false,
											"required": false
										},
										{
											"name": "iconEnd",
											"label": "Icon after text",
											"widget": "string",
											"required": false,
											"hint": "Icon file name without .svg (e.g. chevron-right). See /style-guide for examples."
										}
									]
								},
								{
									"name": "secondary",
									"label": "Secondary button",
									"widget": "object",
									"required": false,
									"fields": [
										{
											"name": "text",
											"label": "Text",
											"widget": "string",
											"required": false
										},
										{
											"name": "textDescription",
											"label": "Accessible description",
											"widget": "string",
											"required": false,
											"hint": "Optional aria-label for screen readers"
										},
										{
											"name": "url",
											"label": "URL",
											"widget": "string",
											"required": false
										},
										{
											"name": "newTab",
											"label": "Open in new tab",
											"widget": "boolean",
											"default": false,
											"required": false
										},
										{
											"name": "iconEnd",
											"label": "Icon after text",
											"widget": "string",
											"required": false,
											"hint": "Icon file name without .svg (e.g. chevron-right). See /style-guide for examples."
										}
									]
								}
							]
						},
						{
							"name": "layout",
							"label": "Layout",
							"widget": "select",
							"options": ["column", "row"],
							"default": "column",
							"required": false,
							"hint": "Row puts the description beside the title on wider screens."
						},
						{
							"name": "align",
							"label": "Alignment",
							"widget": "select",
							"options": ["start", "center"],
							"default": "center",
							"required": false
						},
						{
							"name": "showEyebrow",
							"label": "Show eyebrow",
							"widget": "boolean",
							"default": true,
							"required": false
						},
						{
							"name": "showTitle",
							"label": "Show title",
							"widget": "boolean",
							"default": true,
							"required": false
						},
						{
							"name": "showDescription",
							"label": "Show description",
							"widget": "boolean",
							"default": true,
							"required": false
						},
						{
							"name": "showCta",
							"label": "Show buttons",
							"widget": "boolean",
							"default": true,
							"required": false
						}
					]
				}
			]
		},
