{
	"load_config_file": false,
	"backend": {
		"name": "git-gateway",
		"branch": "main",
		"repo": "https://github.com/axys-creative/svelte-template.git"
	},
	"local_backend": true,
	"media_folder": "static/uploads",
	"public_folder": "/uploads",
	"site_url": "https://axys-template.netlify.app",
	"display_url": "https://axys-template.netlify.app",
	"logo_url": "/images/admin/admin-logo.svg",
	"collections": [
		{
			"name": "page_home",
			"label": "Home Page",
			"files": [
				{
					"name": "hero_simple",
					"label": "Hero",
					"file": "src/lib/content/page_home/hero-simple.json",
					"fields": [
						{
							"name": "eyebrowText",
							"label": "Eyebrow text",
							"widget": "string",
							"required": false
						},
						{
							"name": "title",
							"label": "Title",
							"widget": "string"
						},
						{
							"name": "description",
							"label": "Description",
							"widget": "text",
							"required": false
						},
						{
							"name": "cta",
							"label": "Call to action",
							"widget": "object",
							"fields": [
								{
									"name": "primary",
									"label": "Primary button",
									"widget": "object",
									"required": true,
									"fields": [
										{
											"name": "text",
											"label": "Text",
											"widget": "string",
											"required": true
										},
										{
											"name": "textDescription",
											"label": "Accessible description",
											"widget": "string",
											"required": false,
											"hint": "Optional aria-label for screen readers"
										},
										{
											"name": "url",
											"label": "URL",
											"widget": "string",
											"required": true
										},
										{
											"name": "newTab",
											"label": "Open in new tab",
											"widget": "boolean",
											"default": false,
											"required": false
										}
									]
								},
								{
									"name": "secondary",
									"label": "Secondary button",
									"widget": "object",
									"required": false,
									"fields": [
										{
											"name": "text",
											"label": "Text",
											"widget": "string",
											"required": false
										},
										{
											"name": "textDescription",
											"label": "Accessible description",
											"widget": "string",
											"required": false,
											"hint": "Optional aria-label for screen readers"
										},
										{
											"name": "url",
											"label": "URL",
											"widget": "string",
											"required": false
										},
										{
											"name": "newTab",
											"label": "Open in new tab",
											"widget": "boolean",
											"default": false,
											"required": false
										}
									]
								}
							]
						}
					]
				}
			]
		},
		{
			"name": "meta",
			"label": "Meta Data",
			"editor": {
				"preview": false
			},
			"files": [
				{
					"name": "site",
					"label": "Site Defaults",
					"file": "src/lib/content/meta/site.json",
					"fields": [
						{
							"name": "siteName",
							"label": "Site name",
							"widget": "string"
						},
						{
							"name": "titleTemplate",
							"label": "Title template",
							"widget": "string",
							"hint": "%s is replaced by each page's meta title, e.g. %s | Client Name"
						},
						{
							"name": "description",
							"label": "Default meta description",
							"widget": "text",
							"required": false,
							"hint": "Used when a page has no description of its own."
						},
						{
							"name": "ogImage",
							"label": "Default social share image",
							"widget": "image",
							"required": false
						}
					]
				},
				{
					"name": "pages",
					"label": "Pages",
					"file": "src/lib/content/meta/pages.json",
					"fields": [
						{
							"name": "pages",
							"label": "Pages",
							"label_singular": "Page",
							"widget": "list",
							"allow_add": false,
							"summary": "{{fields.title}}",
							"fields": [
								{
									"name": "path",
									"label": "Path",
									"widget": "hidden"
								},
								{
									"name": "title",
									"label": "Meta title",
									"widget": "string",
									"hint": "Shown in browser tabs and search results. Aim for under 60 characters."
								},
								{
									"name": "description",
									"label": "Meta description",
									"widget": "text",
									"required": false,
									"hint": "Shown in search results. Aim for 120-160 characters."
								},
								{
									"name": "ogImage",
									"label": "Social share image",
									"widget": "image",
									"required": false,
									"hint": "Shown when the page is shared. 1200x630 recommended. Falls back to the site default."
								},
								{
									"name": "crawlPage",
									"label": "Crawl page (default)",
									"widget": "boolean",
									"default": true,
									"required": false,
									"hint": "Uncheck to add a 'noindex, nofollow' meta tag"
								}
							]
						}
					]
				}
			]
		}
	]
}
