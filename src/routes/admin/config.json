{
	"load_config_file": false,
	"backend": {
		"name": "git-gateway",
		"branch": "main",
		"repo": "https://github.com/axys-creative/svelte-template.git"
	},
	"local_backend": true,
	"media_folder": "static/uploads",
	"public_folder": "/uploads",
	"media_library": {
		"config": {
			"max_file_size": 8000000
		}
	},
	"site_url": "https://axys-template.netlify.app",
	"display_url": "https://axys-template.netlify.app",
	"logo_url": "/images/admin/admin-logo.svg",
	"collections": [
		{
			"name": "blog",
			"label": "Blog",
			"label_singular": "Post",
			"description": "Each post is one file in src/lib/content/blog. The file name becomes the address: /blog/the-file-name.",
			"folder": "src/lib/content/blog",
			"extension": "json",
			"format": "json",
			"create": true,
			"slug": "{{slug}}",
			"identifier_field": "title",
			"summary": "{{title}} · {{date}}",
			"preview_path": "blog/{{slug}}",
			"sortable_fields": ["date", "title"],
			"editor": {
				"preview": false
			},
			"fields": [
				{
					"name": "title",
					"label": "Title",
					"widget": "string",
					"hint": "The address of the post comes from the title the first time it is saved. Changing the title later does not change the address."
				},
				{
					"name": "description",
					"label": "Description",
					"widget": "text",
					"hint": "Shown on the blog page and in search results. Keep it under about 155 characters."
				},
				{
					"name": "author",
					"label": "Author",
					"widget": "string",
					"required": false
				},
				{
					"name": "date",
					"label": "Publish date",
					"widget": "datetime",
					"date_format": "YYYY-MM-DD",
					"time_format": false,
					"format": "YYYY-MM-DD"
				},
				{
					"name": "tag",
					"label": "Tag",
					"widget": "select",
					"options": ["Announcement", "Best Practices", "Event", "Press Release", "Update"],
					"required": false
				},
				{
					"name": "coverImage",
					"label": "Cover image",
					"widget": "image",
					"required": false
				},
				{
					"name": "coverAlt",
					"label": "Cover image description",
					"widget": "string",
					"required": false,
					"hint": "Describe the image for screen readers. Leave empty if it is decorative."
				},
				{
					"name": "draft",
					"label": "Draft",
					"widget": "boolean",
					"default": false,
					"required": false,
					"hint": "Drafts are hidden from the site."
				},
				{
					"name": "body",
					"label": "Body",
					"widget": "markdown"
				}
			]
		},
		{
			"name": "page_home",
			"label": "Home Page",
			"files": [
				{
					"name": "hero_simple",
					"label": "Hero",
					"file": "src/lib/content/page_home/hero-simple.json",
					"fields": [
						{
							"name": "eyebrowText",
							"label": "Eyebrow text",
							"widget": "string",
							"required": false
